{
  "name": "@omni/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/development/stop-dev-port.mjs --port 4173",
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "tauri": "tauri",
    "lint": "eslint . --max-warnings 0",
    "build": "tsc -p tsconfig.json && vite build",
    "prebuild:tauri": "node ../../scripts/development/stop-desktop-release.mjs",
    "build:tauri": "node ../../scripts/development/build-desktop-release.mjs",
    "build:installer": "tauri build --config src-tauri/tauri.installer.conf.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:tauri": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration:bridge-contract": "vitest run src/runtime/bridge-contract.integration.test.tsx",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run check && npm run test && npm run build",
    "dev:tauri:fast": "node ../../scripts/development/dev-tauri-fast.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.16.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "magic-string": "^0.30.21",
    "obug": "^2.1.1",
    "rolldown": "^1.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
