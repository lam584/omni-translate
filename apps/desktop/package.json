{
  "name": "@omni/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/development/stop-dev-port.mjs --port 4173",
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "tauri": "tauri",
    "lint": "eslint . --max-warnings 0",
    "build": "tsc -p tsconfig.json && vite build",
    "prebuild:tauri": "node ../../scripts/development/stop-desktop-release.mjs",
    "build:tauri": "node ../../scripts/development/build-desktop-release.mjs",
    "build:installer": "tauri build --config src-tauri/tauri.installer.conf.json --features webrtc-aec3",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:tauri": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration:bridge-contract": "vitest run src/runtime/bridge-contract.integration.test.tsx",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run check && npm run test && npm run build",
    "dev:tauri:fast": "node ../../scripts/development/dev-tauri-fast.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "i18next": "^26.4.7",
    "i18next-browser-languagedetector": "^8.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.0.20",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.4"
  }
}
