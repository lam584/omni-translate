{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omni Translate",
  "version": "0.1.0",
  "identifier": "com.omni.translate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Omni Translate",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}