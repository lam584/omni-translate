{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkedAt",
    "verification",
    "networkAuthorized",
    "enabledBindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "model-protocol-families/v1"
    },
    "checkedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "verification": {
      "const": "fixture-only"
    },
    "networkAuthorized": {
      "const": false
    },
    "enabledBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "profileId",
          "profileVersion",
          "dialectId",
          "dialectVersion",
          "adapterId",
          "operations",
          "exactModelIds",
          "terminalLifecycle",
          "wireFixture"
        ],
        "properties": {
          "owner": {
            "const": "bailian"
          },
          "profileId": {
            "type": "string",
            "pattern": "^bailian\\.[a-z0-9._-]+$"
          },
          "profileVersion": {
            "type": "integer",
            "minimum": 1
          },
          "dialectId": {
            "type": "string",
            "minLength": 1
          },
          "dialectVersion": {
            "type": "integer",
            "minimum": 1
          },
          "adapterId": {
            "enum": [
              "desktop-livetranslate-session-v1",
              "desktop-livetranslate-session-v2",
              "desktop-omni-session-v2",
              "desktop-qwen-audio-session-v1",
              "desktop-qwen-audio-task-asr-v1",
              "desktop-qwen-audio-task-tts-v1"
            ]
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "native_translate",
                "dialogue",
                "asr",
                "tts"
              ]
            }
          },
          "exactModelIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "terminalLifecycle": {
            "type": "string",
            "minLength": 1
          },
          "wireFixture": {
            "type": "string",
            "pattern": "^(apps/desktop/src-tauri/fixtures/model-protocol|provider-modules/bailian/fixtures)/[a-z0-9-]+\\.json$"
          }
        }
      }
    }
  }
}
