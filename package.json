{
  "name": "omni-translate",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "scripts": {
    "dev:desktop": "npm run dev --workspace @omni/desktop",
    "dev:desktop-shell": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/development/run-desktop-shell-elevated.ps1",
    "lint:desktop": "npm run lint --workspace @omni/desktop",
    "build:desktop": "npm run build --workspace @omni/desktop",
    "build:desktop-shell": "npm run build:tauri --workspace @omni/desktop",
    "check:desktop": "npm run check --workspace @omni/desktop",
    "check:desktop-shell": "npm run check:tauri --workspace @omni/desktop",
    "test:desktop-shell": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:desktop-coverage": "npm run test:coverage --workspace @omni/desktop",
    "test:llm-integration": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/testing/run-llm-integration.ps1",
    "test:all": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/testing/run-all-tests.ps1",
    "verify:desktop": "npm run verify --workspace @omni/desktop",
    "check:bridge-service-native": "cargo check --manifest-path apps/bridge-service-native/Cargo.toml",
    "build:bridge-service-native": "cargo build --release --manifest-path apps/bridge-service-native/Cargo.toml",
    "test:bridge-service-native": "cargo test --manifest-path apps/bridge-service-native/Cargo.toml",
    "coverage:tooling": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/testing/bootstrap-coverage-tooling.ps1",
    "coverage:gate": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/testing/run-coverage-gate.ps1",
    "driver:build-sysvad": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/installer/build-sysvad-driver.ps1 -WorkspaceRoot .",
    "driver:test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/installer/test-development-driver.ps1",
    "driver:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/installer/install-development-driver.ps1 -WorkspaceRoot . -RuntimeRoot ./artifacts/diagnostics/logs -InstallChannel development -DriverVersion 0.10.0-dev -BridgeVersion 0.1.0 -TargetDeviceId virtual-mic-default",
    "driver:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/installer/uninstall-development-driver.ps1 -WorkspaceRoot . -RuntimeRoot ./artifacts/diagnostics/logs -InstallChannel development -DriverVersion 0.10.0-dev -BridgeVersion 0.1.0 -TargetDeviceId virtual-mic-default",
    "driver:repair": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/installer/repair-driver.ps1 -WorkspaceRoot . -RuntimeRoot ./artifacts/diagnostics/logs -InstallChannel development -DriverVersion 0.10.0-dev -BridgeVersion 0.1.0 -TargetDeviceId virtual-mic-default -Action reinstall-driver",
    "installer:prepare": "node ./scripts/release/prepare-installer-layout.mjs",
    "smoke:desktop-e2e": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/testing/prepare-manual-e2e-report.ps1",
    "perf:desktop-baseline": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/testing/prepare-performance-baseline.ps1",
    "perf:startup-readiness": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/testing/measure-startup-readiness.ps1",
    "test:install-regression": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/testing/prepare-install-regression-report.ps1",
    "test:contracts": "node ./scripts/testing/verify-contracts.mjs",
    "test:integration:bridge-contract": "npm run test:integration:bridge-contract --workspace @omni/desktop",
    "audit:architecture": "node ./scripts/testing/audit-architecture-boundaries.mjs",
    "audit:architecture:strict": "node ./scripts/testing/audit-architecture-boundaries.mjs --strict",
    "audit:dead-code": "node ./scripts/testing/audit-rust-dead-code.mjs",
    "audit:repository-hygiene": "node ./scripts/testing/audit-repository-hygiene.mjs",
    "i18n:coverage": "node ./scripts/testing/i18n-coverage.mjs",
    "i18n:coverage:strict": "node ./scripts/testing/i18n-coverage.mjs --min-translation-coverage=100",
    "test:watch-mode-report": "node --test ./scripts/testing/watch-mode-report.test.mjs ./scripts/testing/run-watch-mode-live.test.mjs ./scripts/testing/generate-watch-mode-live-fixtures.test.mjs ./scripts/testing/verify-watch-mode-evidence.test.mjs",
    "test:release-lib": "node --test ./scripts/lib/release-common.test.mjs",
    "test:startup-readiness": "node --test ./scripts/testing/measure-startup-readiness.test.mjs",
    "test:driver-boundaries": "node --test ./drivers/windows-virtual-mic/tests/install-state.test.mjs ./drivers/windows-virtual-mic/tests/bridge-frame-writes.test.mjs ./drivers/windows-virtual-mic/tests/endpoint-isolation.test.mjs",
    "test:watch-mode-evidence": "node ./scripts/testing/verify-watch-mode-evidence.mjs",
    "test:watch-mode-evidence:strict": "node ./scripts/testing/verify-watch-mode-evidence.mjs --strict --models qwen3.5-omni-flash-realtime,qwen3.5-livetranslate-flash-realtime --feedback-modes virtual-driver,echo-cancel",
    "generate:watch-mode-live-fixtures": "node ./scripts/testing/generate-watch-mode-live-fixtures.mjs",
    "audit:worktree-groups": "node ./scripts/testing/audit-worktree-groups.mjs",
    "test:watch-mode-live": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/testing/run-watch-mode-live.ps1",
    "test:watch-mode-live:matrix": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/testing/run-watch-mode-live-matrix.ps1",
    "test:watch-mode-live:dry-run": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/testing/run-watch-mode-live.ps1 -DryRun",
    "quality:desktop-shell": "npm run check:desktop-shell && npm run test:desktop-shell",
    "quality:gate": "npm run quality:gate:release",
    "release:manifest": "node ./scripts/release/generate-release-manifest.mjs",
    "release:package": "node ./scripts/release/create-release-package.mjs",
    "release:signing-manifest": "node ./scripts/release/generate-signing-manifest.mjs",
    "release:finalize-signed": "node ./scripts/release/finalize-signed-package.mjs",
    "release:verify": "node ./scripts/release/verify-release.mjs && npm run quality:gate:release && npm run test:watch-mode-evidence:strict",
    "release:prepare": "npm run release:verify && npm run release:manifest && npm run installer:prepare && npm run release:package && npm run release:signing-manifest",
    "quality:gate:auto": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/testing/run-quality-gate-auto.ps1",
    "quality:gate:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/testing/run-quality-gate.ps1",
    "dev:desktop:fast": "npm run dev:tauri:fast --workspace @omni/desktop",
    "perf:startup-readiness:fast": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/testing/measure-startup-readiness.ps1 -UseFastDev"
  }
}
