        "direction": "client",
        "frameKind": "json",
        "eventType": "session.update",
        "wire": {
          "type": "session.update",
          "session": {
            "audio": {
              "input": {
                "turn_detection": null,
                "format": {
                  "type": "pcm",
                  "sample_rate": 16000
                }
              },
              "output": {
                "format": {
                  "type": "pcm",
                  "sample_rate": 24000
                }
              }
            }
          }
        }
      },
      "expectedFailure": "session.turn_detection required"
    },
