{
  "schemaVersion": "model-protocol-wire-fixture/v1",
  "dialectId": "bailian-livetranslate-session-ws-v2",
  "checkedAt": "2026-09-20",
  "sanitized": true,
  "sources": [
    {
      "url": "https://help.aliyun.com/zh/model-studio/qwen3-5-livetranslate-flash-realtime",
      "checkedAt": "2026-09-20"
    },
    {
      "url": "https://help.aliyun.com/zh/model-studio/live-translator-client-events",
      "checkedAt": "2026-09-20"
    },
    {
      "url": "https://help.aliyun.com/zh/model-studio/live-translator-server-events",
      "checkedAt": "2026-09-20"
    }
  ],
  "sequence": [
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "session.created"
    },
    {
      "direction": "client",
      "frameKind": "json",
      "eventType": "session.update",
      "payload": {
        "session": {
          "output_modalities": [
            "text",
            "audio"
          ],
          "translation": {
            "language": "zh"
          },
          "audio": {
            "input": {
              "turn_detection": {
                "type": "speaker_detection"
              }
            }
          }
        }
      }
    },
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "session.updated"
    },
    {
      "direction": "client",
      "frameKind": "json-base64",
      "eventType": "input_audio_buffer.append"
    },
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "conversation.item.input_audio_transcription.delta",
      "payload": {
        "delta": "Hello"
      }
    },
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "conversation.item.input_audio_transcription.completed",
      "payload": {
        "transcript": "Hello"
      }
    },
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "response.created"
    },
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "response.output_item.added"
    },
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "response.content_part.added"
    },
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "response.text.delta",
      "payload": {
        "delta": "你好"
      }
    },
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "response.text.delta",
      "payload": {
        "delta": "啊"
      }
    },
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "response.text.done",
      "payload": {
        "text": "你好啊"
      }
    },
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "response.content_part.done"
    },
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "response.output_item.done"
    },
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "response.done"
    },
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "response.audio_transcript.delta",
      "payload": {
        "delta": "你好"
      }
    },
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "response.audio_transcript.done",
      "payload": {
        "transcript": "你好"
      }
    },
    {
      "direction": "client",
      "frameKind": "json",
      "eventType": "session.finish"
    },
    {
      "direction": "server",
      "frameKind": "json",
      "eventType": "session.finished"
    }
  ],
  "expect": {
    "previewAfterSecondDelta": "你好啊",
    "committedText": "你好啊",
    "terminalOrder": [
      "session.finish",
      "session.finished"
    ],
    "forbiddenEvents": [
      "response.text.text",
      "response.create",
      "conversation.item.input_audio_transcription.text",
      "response.audio_transcript.text"
    ]
  }
}
