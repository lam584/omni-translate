  "lifecycleProfiles": [
    {
      "id": "google-gemini.openai-chat-stream",
      "handshake": [],
      "clientEvents": [
        "chat.completions.create"
      ],
      "serverEvents": [
        "chat.completion.chunk",
        "data.done"
      ],
      "vadModes": [
        "none"
      ],
      "terminal": "A chunk finish_reason or the SSE data marker [DONE] terminates one request.",
      "reuse": "sequential-tasks",
      "textDeltaSemantics": "append-delta"
    },
    {
      "id": "google-gemini.live-agent",
      "handshake": [
        "setup",
        "setupComplete"
      ],
      "clientEvents": [
        "clientContent",
        "realtimeInput.audio",
        "realtimeInput.activityStart",
        "realtimeInput.activityEnd",
        "realtimeInput.audioStreamEnd",
        "toolResponse"
      ],
      "serverEvents": [
        "setupComplete",
        "serverContent.modelTurn",
        "serverContent.inputTranscription",
        "serverContent.outputTranscription",
        "serverContent.generationComplete",
        "serverContent.interrupted",
        "serverContent.turnComplete",
        "toolCall",
        "toolCallCancellation",
        "sessionResumptionUpdate",
        "goAway"
      ],
      "vadModes": [
        "server-vad",
        "client-activity",
        "manual"
      ],
      "terminal": "Normal generation emits generationComplete before turnComplete. An interrupted generation emits interrupted then turnComplete and omits generationComplete; turnComplete closes the turn.",
      "reuse": "multi-turn",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "append-delta"
    },
    {
      "id": "google-gemini.live-translation",
      "handshake": [
        "setup.translationConfig",
        "setupComplete"
      ],
      "clientEvents": [
        "realtimeInput.audio",
        "realtimeInput.audioStreamEnd"
      ],
      "serverEvents": [
        "serverContent.inputTranscription",
        "serverContent.outputTranscription",
        "serverContent.modelTurn.audio",
        "serverContent.generationComplete",
        "serverContent.interrupted",
        "serverContent.turnComplete",
        "goAway",
        "sessionResumptionUpdate"
      ],
      "vadModes": [
        "server-vad",
        "manual"
      ],
      "terminal": "turnComplete closes each translated audio turn; interrupted replaces generationComplete on interrupted turns.",
      "reuse": "multi-turn",
      "textDeltaSemantics": "mixed"
    },
    {
      "id": "google-gemini.live-transcription",
      "handshake": [
        "setup",
        "setupComplete"
      ],
      "clientEvents": [
        "realtimeInput.audio",
        "realtimeInput.audioStreamEnd",
        "realtimeInput.activityStart",
        "realtimeInput.activityEnd"
      ],
      "serverEvents": [
        "serverContent.interimInputTranscription",
        "serverContent.inputTranscription",
        "serverContent.turnComplete",
        "goAway",
        "sessionResumptionUpdate"
      ],
      "vadModes": [
        "server-vad",
        "client-activity",
        "manual"
      ],
      "terminal": "inputTranscription is the finalized segment; interimInputTranscription is replaceable and must not be appended as final history.",
      "reuse": "multi-turn",
      "textDeltaSemantics": "mixed"
    },
    {
      "id": "google-gemini.interactions-single",
      "handshake": [],
      "clientEvents": [
        "interactions.create"
      ],
      "serverEvents": [
        "interaction"
      ],
      "vadModes": [
        "none"
      ],
      "terminal": "The HTTP interaction response is terminal when its status is completed or failed.",
      "reuse": "single-request",
      "textDeltaSemantics": "not-applicable"
    },
    {
      "id": "google-gemini.interactions-stream",
      "handshake": [],
      "clientEvents": [
        "interactions.create.stream"
      ],
      "serverEvents": [
        "interaction.created",
        "step.start",
        "step.delta",
        "step.stop",
        "interaction.completed",
        "done"
      ],
      "vadModes": [
        "none"
      ],
      "terminal": "interaction.completed is the semantic terminal event and the SSE stream then emits data: [DONE].",
      "reuse": "single-request",
      "textDeltaSemantics": "append-delta"
    }
  ],
