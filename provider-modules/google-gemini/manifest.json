          "credentialFieldId": "api-key",
          "required": true
        }
      ]
    },
    {
      "id": "google-gemini.openai-bearer",
      "type": "bearer",
      "credentialId": "google-gemini.api-key",
      "parameters": [
        {
          "location": "header",
          "name": "Authorization",
          "source": "credential",
          "credentialFieldId": "api-key",
          "scheme": "Bearer",
          "required": true
        }
      ]
    },
    {
      "id": "google-gemini.oauth2-bearer",
      "type": "bearer",
      "credentialId": "google-gemini.oauth-client",
      "parameters": [
        {
          "location": "header",
          "name": "Authorization",
          "source": "derived",
          "derivation": "Acquire or refresh an OAuth 2.0 access token from Google Application Default Credentials or the configured desktop client.",
          "scheme": "Bearer",
          "required": true
        },
        {
          "location": "header",
          "name": "x-goog-user-project",
          "source": "credential",
          "credentialFieldId": "project-id",
          "required": true
        }
      ],
      "credentialBootstrap": {
        "kind": "oauth2",
        "scope": "https://www.googleapis.com/auth/cloud-platform https://www.googleapis.com/auth/generative-language.retriever",
        "description": "OAuth is documented for the Gemini REST API. The reviewed raw Live WebSocket guide does not establish OAuth as a Live authentication profile.",
        "documentationIds": [
          "google-gemini.oauth"
        ]
      }
    },
    {
      "id": "google-gemini.ephemeral-query",
      "type": "token",
      "credentialId": "google-gemini.api-key",
      "parameters": [
        {
          "location": "query",
          "name": "access_token",
          "source": "derived",
          "derivation": "Use the name returned by POST /v1beta/auth_tokens and connect to BidiGenerateContentConstrained.",
          "required": true
        }
      ],
      "credentialBootstrap": {
        "kind": "ephemeral-token-exchange",
        "endpointTemplate": "https://generativelanguage.googleapis.com/v1beta/auth_tokens",
        "description": "A trusted backend exchanges the long-lived API key for a constrained short-lived Live API token.",
        "documentationIds": [
          "google-gemini.ephemeral-tokens",
          "google-gemini.live-reference"
        ]
      }
    },
    {
      "id": "google-gemini.ephemeral-token-header",
      "type": "token",
      "credentialId": "google-gemini.api-key",
      "parameters": [
        {
          "location": "header",
          "name": "Authorization",
          "source": "derived",
          "derivation": "Use the name returned by POST /v1beta/auth_tokens and connect to BidiGenerateContentConstrained.",
          "scheme": "Token",
          "required": true
        }
      ],
      "credentialBootstrap": {
        "kind": "ephemeral-token-exchange",
        "endpointTemplate": "https://generativelanguage.googleapis.com/v1beta/auth_tokens",
        "description": "The constrained token may be sent in Authorization with the Token scheme; it is not a Bearer token.",
        "documentationIds": [
          "google-gemini.ephemeral-tokens",
          "google-gemini.live-reference"
        ]
      }
    }
