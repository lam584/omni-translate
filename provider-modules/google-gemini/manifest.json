        {
          "id": "client-secret",
          "label": "OAuth client secret",
          "secret": true,
          "required": false,
          "format": "Google OAuth 2.0 desktop client secret when not using ADC"
        },
        {
          "id": "project-id",
          "label": "Google Cloud project ID",
          "secret": false,
          "required": true,
          "format": "Project billed through x-goog-user-project"
        },
        {
          "id": "refresh-token",
          "label": "OAuth refresh token",
          "secret": true,
          "required": false,
          "format": "Optional cached user authorization token"
        }
      ]
    }
