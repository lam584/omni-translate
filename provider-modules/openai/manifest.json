  "lifecycleProfiles": [
    {
      "id": "openai.lifecycle.chat-completions-sse",
      "handshake": ["http.request", "http.response.open"],
      "clientEvents": ["chat.completion.request"],
      "serverEvents": ["chat.completion.chunk", "data:[DONE]", "http.error"],
      "vadModes": ["none"],
      "terminal": "A streamed Chat Completions request ends at data: [DONE] or an HTTP/transport error; finish_reason terminates a choice but does not replace the stream terminator.",
      "reuse": "single-request",
      "textDeltaSemantics": "append-delta"
    },
    {
      "id": "openai.lifecycle.realtime-conversation",
      "handshake": ["session.created", "session.update", "session.updated"],
      "clientEvents": [
        "session.update",
        "input_audio_buffer.append",
        "input_audio_buffer.commit",
        "input_audio_buffer.clear",
        "response.create",
        "response.cancel"
      ],
      "serverEvents": [
        "session.created",
        "session.updated",
        "input_audio_buffer.speech_started",
        "input_audio_buffer.speech_stopped",
        "input_audio_buffer.committed",
        "conversation.item.input_audio_transcription.delta",
        "conversation.item.input_audio_transcription.completed",
        "response.output_text.delta",
        "response.output_text.done",
        "response.output_audio.delta",
        "response.output_audio.done",
        "response.output_audio_transcript.delta",
        "response.output_audio_transcript.done",
        "response.done",
        "error"
      ],
      "vadModes": ["manual", "server-vad", "semantic-vad"],
      "terminal": "response.done terminates one Response only; status must be completed before success. cancelled, failed, and incomplete are non-success outcomes and the session can remain reusable.",
      "reuse": "multi-turn",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "append-delta"
    },
    {
      "id": "openai.lifecycle.realtime-translation",
      "handshake": ["session.created", "session.update", "session.updated"],
      "clientEvents": [
        "session.update",
        "session.input_audio_buffer.append",
        "session.close"
      ],
      "serverEvents": [
        "session.created",
        "session.updated",
        "session.input_transcript.delta",
        "session.output_transcript.delta",
        "session.output_audio.delta",
        "error",
        "session.closed"
      ],
      "vadModes": ["none"],
      "terminal": "The client sends session.close, stops appending audio, continues reading until session.closed, and only then closes the WebSocket. Recoverable error events do not terminate the session.",
      "reuse": "single-session",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "append-delta"
    },
    {
      "id": "openai.lifecycle.realtime-transcription",
      "handshake": ["session.created", "session.update", "session.updated"],
      "clientEvents": [
        "session.update",
        "input_audio_buffer.append",
        "input_audio_buffer.commit",
        "input_audio_buffer.clear"
      ],
      "serverEvents": [
        "session.created",
        "session.updated",
        "conversation.item.input_audio_transcription.delta",
        "conversation.item.input_audio_transcription.completed",
        "conversation.item.input_audio_transcription.failed",
        "error"
      ],
      "vadModes": ["manual", "server-vad", "semantic-vad"],
      "terminal": "conversation.item.input_audio_transcription.completed or .failed terminates one committed item; connection closure terminates the session.",
      "reuse": "sequential-tasks",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "append-delta"
    },
    {
      "id": "openai.lifecycle.realtime-transcription-whisper-manual",
      "handshake": ["session.created", "session.update", "session.updated"],
      "clientEvents": [
        "session.update",
        "input_audio_buffer.append",
        "input_audio_buffer.commit",
        "input_audio_buffer.clear"
      ],
      "serverEvents": [
        "session.created",
        "session.updated",
        "conversation.item.input_audio_transcription.delta",
        "conversation.item.input_audio_transcription.completed",
        "conversation.item.input_audio_transcription.failed",
        "error"
      ],
      "vadModes": ["manual"],
      "terminal": "GPT-Realtime-Whisper requires turn_detection null; each explicit commit ends with transcription completed or failed.",
      "reuse": "sequential-tasks",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "append-delta"
    },
    {
      "id": "openai.lifecycle.http-single-request",
      "handshake": ["http.request"],
      "clientEvents": ["http.request"],
      "serverEvents": ["http.response", "http.error"],
      "vadModes": ["none"],
      "terminal": "The HTTP response body or an HTTP error terminates the request.",
      "reuse": "single-request",
      "textDeltaSemantics": "not-applicable"
    },
    {
      "id": "openai.lifecycle.transcription-sse",
      "handshake": ["http.request", "http.response.open"],
      "clientEvents": ["http.multipart.request"],
      "serverEvents": ["transcript.text.delta", "transcript.text.done", "http.error"],
      "vadModes": ["none"],
      "terminal": "transcript.text.done or an HTTP/SSE error terminates the streamed file transcription request.",
      "reuse": "single-request",
      "textDeltaSemantics": "append-delta"
    }
  ],
