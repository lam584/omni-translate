  "credentials": [
    {
      "id": "tencent-speech-credentials",
      "reference": "credential://provider/tencent-cloud/speech",
      "fields": [
        { "id": "appid", "label": "AppID", "secret": false, "required": true, "format": "decimal account application id" },
        { "id": "secret-id", "label": "SecretID", "secret": true, "required": true, "format": "Tencent Cloud CAM SecretID" },
        { "id": "secret-key", "label": "SecretKey", "secret": true, "required": true, "format": "Tencent Cloud CAM SecretKey" }
      ]
    },
    {
      "id": "tencent-cloudapi-credentials",
      "reference": "credential://provider/tencent-cloud/cloudapi",
      "fields": [
        { "id": "secret-id", "label": "SecretID", "secret": true, "required": true, "format": "Tencent Cloud CAM SecretID" },
        { "id": "secret-key", "label": "SecretKey", "secret": true, "required": true, "format": "Tencent Cloud CAM SecretKey" },
        { "id": "security-token", "label": "Temporary security token", "secret": true, "required": false, "format": "X-TC-Token value for temporary credentials" }
      ]
    }
  ],
  "authProfiles": [
    {
      "id": "speech-translate-hmac-sha1-query",
      "type": "hmac-sha1-query",
      "credentialId": "tencent-speech-credentials",
      "parameters": [
        { "location": "path", "name": "appid", "source": "credential", "credentialFieldId": "appid", "required": true },
        { "location": "query", "name": "secretid", "source": "credential", "credentialFieldId": "secret-id", "required": true },
        { "location": "query", "name": "timestamp", "source": "derived", "derivation": "current Unix timestamp in seconds", "required": true },
        { "location": "query", "name": "expired", "source": "derived", "derivation": "timestamp plus configured TTL, less than 90 days", "required": true },
        { "location": "query", "name": "nonce", "source": "derived", "derivation": "random positive integer of at most ten digits", "required": true },
        { "location": "query", "name": "voice_id", "source": "derived", "derivation": "new UUID for every WebSocket connection", "required": true },
        { "location": "query", "name": "signature", "source": "derived", "derivation": "URL-encoded Base64 HMAC-SHA1 signature", "required": true }
      ],
      "signing": {
        "algorithm": "hmac-sha1",
        "canonicalization": "Sort every query parameter except signature by key, join as key=value with ampersands, prefix as asr.cloud.tencent.com/asr/speech_translate/{appid}?, omit wss://, HMAC with SecretKey, Base64 encode, then URL encode the signature.",
        "signatureEncoding": "base64",
        "signatureParameterName": "signature",
        "signedParameterNames": ["expired", "nonce", "secretid", "source", "target", "timestamp", "trans_model", "voice_format", "voice_id"]
      }
    },
    {
      "id": "asr-v2-hmac-sha1-query",
      "type": "hmac-sha1-query",
      "credentialId": "tencent-speech-credentials",
      "parameters": [
        { "location": "path", "name": "appid", "source": "credential", "credentialFieldId": "appid", "required": true },
        { "location": "query", "name": "secretid", "source": "credential", "credentialFieldId": "secret-id", "required": true },
        { "location": "query", "name": "timestamp", "source": "derived", "derivation": "current Unix timestamp in seconds", "required": true },
        { "location": "query", "name": "expired", "source": "derived", "derivation": "signature expiry timestamp", "required": true },
        { "location": "query", "name": "nonce", "source": "derived", "derivation": "random positive integer", "required": true },
        { "location": "query", "name": "voice_id", "source": "derived", "derivation": "new UUID for every WebSocket connection", "required": true },
        { "location": "query", "name": "signature", "source": "derived", "derivation": "URL-encoded Base64 HMAC-SHA1 signature", "required": true }
      ],
      "signing": {
        "algorithm": "hmac-sha1",
        "canonicalization": "Tencent realtime ASR v2 sorted URL query signing over asr.cloud.tencent.com/asr/v2/{appid}; exclude signature and the wss:// prefix.",
        "signatureEncoding": "base64",
        "signatureParameterName": "signature"
      }
    },
    {
      "id": "sts-tc3-sha256-query",
      "type": "hmac-sha256-query",
      "credentialId": "tencent-speech-credentials",
      "parameters": [
        { "location": "path", "name": "appid", "source": "credential", "credentialFieldId": "appid", "required": true },
        { "location": "query", "name": "secretId", "source": "credential", "credentialFieldId": "secret-id", "required": true },
        { "location": "query", "name": "timeStamp", "source": "derived", "derivation": "current Unix timestamp in seconds", "required": true },
        { "location": "query", "name": "expired", "source": "derived", "derivation": "signature expiry timestamp later than timeStamp", "required": true },
        { "location": "query", "name": "nonce", "source": "derived", "derivation": "one-time anti-replay string", "required": true },
        { "location": "header", "name": "content-type", "source": "static", "staticValue": "application/json; charset=utf-8", "required": true },
        { "location": "header", "name": "host", "source": "static", "staticValue": "mps.cloud.tencent.com", "required": true },
        { "location": "query", "name": "signature", "source": "derived", "derivation": "hex CAM-style HMAC-SHA256 signature", "required": true }
      ],
      "signing": {
        "algorithm": "hmac-sha256",
        "canonicalization": "Tencent CAM/TC3-style chain over POST, /sts/v1/{appid}, the sorted URL-encoded query excluding signature, canonical content-type and host headers, signed headers content-type;host, and SHA256 of an empty payload.",
        "signatureEncoding": "hex",
        "signatureParameterName": "signature",
        "signedParameterNames": ["content-type", "host", "secretId", "timeStamp", "expired", "nonce", "mode", "voice", "inputFormat", "inputSampleRate", "outputFormat", "outputSampleRate", "lang", "dstLang"]
      }
    },
    {
      "id": "tts-ws-v1-hmac-sha1-query",
      "type": "hmac-sha1-query",
      "credentialId": "tencent-speech-credentials",
      "parameters": [
        { "location": "query", "name": "Action", "source": "static", "staticValue": "TextToStreamAudioWS", "required": true },
        { "location": "query", "name": "AppId", "source": "credential", "credentialFieldId": "appid", "required": true },
        { "location": "query", "name": "SecretId", "source": "credential", "credentialFieldId": "secret-id", "required": true },
        { "location": "query", "name": "Timestamp", "source": "derived", "derivation": "current Unix timestamp in seconds", "required": true },
        { "location": "query", "name": "Expired", "source": "derived", "derivation": "signature expiry timestamp", "required": true },
        { "location": "query", "name": "SessionId", "source": "derived", "derivation": "new UUID per WebSocket connection", "required": true },
        { "location": "query", "name": "Signature", "source": "derived", "derivation": "URL-encoded Base64 HMAC-SHA1 signature", "required": true }
      ],
      "signing": {
        "algorithm": "hmac-sha1",
        "canonicalization": "Sort every query parameter except Signature and prefix the query with GETtts.cloud.tencent.com/stream_ws before HMAC-SHA1; Base64 and URL encode the result.",
        "signatureEncoding": "base64",
        "signatureParameterName": "Signature"
      }
    },
    {
      "id": "tts-wsv2-hmac-sha1-query",
      "type": "hmac-sha1-query",
      "credentialId": "tencent-speech-credentials",
      "parameters": [
        { "location": "query", "name": "Action", "source": "static", "staticValue": "TextToStreamAudioWSv2", "required": true },
        { "location": "query", "name": "AppId", "source": "credential", "credentialFieldId": "appid", "required": true },
        { "location": "query", "name": "SecretId", "source": "credential", "credentialFieldId": "secret-id", "required": true },
        { "location": "query", "name": "Timestamp", "source": "derived", "derivation": "current Unix timestamp in seconds", "required": true },
        { "location": "query", "name": "Expired", "source": "derived", "derivation": "signature expiry timestamp", "required": true },
        { "location": "query", "name": "SessionId", "source": "derived", "derivation": "new UUID per WebSocket connection", "required": true },
        { "location": "query", "name": "Signature", "source": "derived", "derivation": "URL-encoded Base64 HMAC-SHA1 signature", "required": true }
      ],
      "signing": {
        "algorithm": "hmac-sha1",
        "canonicalization": "Sort every query parameter except Signature and prefix the query with GETtts.cloud.tencent.com/stream_wsv2 before HMAC-SHA1; Base64 and URL encode the result.",
        "signatureEncoding": "base64",
        "signatureParameterName": "Signature"
      }
    },
    {
      "id": "cloudapi-tc3-header",
      "type": "hmac-sha256-header",
      "credentialId": "tencent-cloudapi-credentials",
      "parameters": [
        { "location": "header", "name": "Authorization", "source": "derived", "derivation": "TC3-HMAC-SHA256 Credential, SignedHeaders, and Signature value", "scheme": "TC3-HMAC-SHA256", "required": true },
        { "location": "header", "name": "Content-Type", "source": "static", "staticValue": "application/json; charset=utf-8", "required": true },
        { "location": "header", "name": "Host", "source": "static", "staticValue": "tts.tencentcloudapi.com", "required": true },
        { "location": "header", "name": "X-TC-Action", "source": "derived", "derivation": "operation action from the selected API family", "required": true },
        { "location": "header", "name": "X-TC-Version", "source": "static", "staticValue": "2019-08-23", "required": true },
        { "location": "header", "name": "X-TC-Timestamp", "source": "derived", "derivation": "current Unix timestamp in seconds", "required": true },
        { "location": "header", "name": "X-TC-Region", "source": "derived", "derivation": "configured Tencent Cloud region when the operation uses one", "required": false },
        { "location": "header", "name": "X-TC-Token", "source": "credential", "credentialFieldId": "security-token", "required": false }
      ],
      "signing": {
        "algorithm": "hmac-sha256",
        "canonicalization": "TC3-HMAC-SHA256 canonical request and date/service/tc3_request credential scope with content-type and host as mandatory signed headers.",
        "signatureEncoding": "hex",
        "signatureParameterName": "Authorization",
        "signedParameterNames": ["content-type", "host"]
      }
    }
  ],
  "transports": [
    {
      "id": "tencent-ws-json-raw-binary",
      "kind": "websocket",
      "requestFraming": "json-and-binary",
      "responseFraming": "json-and-binary",
      "requestEnvelope": { "kind": "none", "byteOrder": "not-applicable", "description": "WebSocket Text JSON control frames and naked WebSocket Binary audio frames." },
      "responseEnvelope": { "kind": "none", "byteOrder": "not-applicable", "description": "WebSocket Text JSON events and naked WebSocket Binary audio frames." }
    },
    {
      "id": "tencent-ws-query-raw-binary",
      "kind": "websocket",
      "requestFraming": "none",
      "responseFraming": "json-and-binary",
      "requestEnvelope": { "kind": "none", "byteOrder": "not-applicable", "description": "All request text and synthesis options are carried by the signed WebSocket Upgrade URL." },
      "responseEnvelope": { "kind": "none", "byteOrder": "not-applicable", "description": "Naked audio Binary frames plus Text JSON state frames." }
    },
    {
      "id": "tencent-ws-json-out-raw-binary",
      "kind": "websocket",
      "requestFraming": "json",
      "responseFraming": "json-and-binary",
      "requestEnvelope": { "kind": "none", "byteOrder": "not-applicable", "description": "ACTION control records are WebSocket Text JSON frames." },
      "responseEnvelope": { "kind": "none", "byteOrder": "not-applicable", "description": "Naked audio Binary frames plus Text JSON state and subtitle frames." }
    },
    {
      "id": "tencent-http-json-base64",
      "kind": "http",
      "requestFraming": "json",
      "responseFraming": "json-base64",
      "requestEnvelope": { "kind": "none", "byteOrder": "not-applicable", "description": "HTTPS JSON request body." },
      "responseEnvelope": { "kind": "none", "byteOrder": "not-applicable", "description": "HTTPS JSON response with Base64 audio or asynchronous task metadata." }
    }
  ],
  "audioProfiles": [
    {
      "id": "tencent-speech-translate-audio",
      "input": { "required": true, "formats": ["pcm-s16le", "wav-pcm-s16le"], "sampleRatesHz": [16000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian"], "chunkDurationMs": { "recommended": 200 } },
      "output": { "required": false, "formats": ["pcm-s16le", "mp3"], "sampleRatesHz": [16000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian", "not-applicable"] }
    },
    {
      "id": "tencent-asr-v2-audio",
      "input": { "required": true, "formats": ["pcm-s16le", "wav-pcm-s16le", "opus", "speex", "silk", "mp3", "m4a", "aac"], "sampleRatesHz": [8000, 16000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian", "not-applicable"], "chunkDurationMs": { "recommended": 200 } },
      "output": { "required": false, "formats": [], "sampleRatesHz": [], "channels": [] }
    },
    {
      "id": "tencent-sts-audio",
      "input": { "required": true, "formats": ["pcm-s16le"], "sampleRatesHz": [8000, 16000, 24000, 32000, 48000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian"], "chunkDurationMs": { "minimum": 20, "maximum": 100, "recommended": 20 } },
      "output": { "required": true, "formats": ["pcm-s16le", "mp3", "wav", "flac", "opus", "ulaw", "alaw"], "sampleRatesHz": [8000, 16000, 24000, 32000, 48000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian", "not-applicable"] }
    },
    {
      "id": "tencent-tts-ws-v1-audio",
      "input": { "required": false, "formats": [], "sampleRatesHz": [], "channels": [] },
      "output": { "required": true, "formats": ["pcm-s16le", "mp3"], "sampleRatesHz": [8000, 16000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian", "not-applicable"] }
    },
    {
      "id": "tencent-tts-wsv2-audio",
      "input": { "required": false, "formats": [], "sampleRatesHz": [], "channels": [] },
      "output": { "required": true, "formats": ["pcm-s16le", "mp3"], "sampleRatesHz": [8000, 16000, 24000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian", "not-applicable"] }
    },
    {
      "id": "tencent-tts-cloudapi-audio",
      "input": { "required": false, "formats": [], "sampleRatesHz": [], "channels": [] },
      "output": { "required": true, "formats": ["wav-pcm-s16le", "mp3", "pcm-s16le"], "sampleRatesHz": [8000, 16000, 24000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian", "not-applicable"] }
    },
    {
      "id": "tencent-tts-long-text-audio",
      "input": { "required": false, "formats": [], "sampleRatesHz": [], "channels": [] },
      "output": { "required": true, "formats": ["mp3", "wav-pcm-s16le", "pcm-s16le"], "sampleRatesHz": [8000, 16000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian", "not-applicable"] }
    }
  ],
  "lifecycleProfiles": [
    {
      "id": "tencent-speech-translate-lifecycle",
      "handshake": ["websocket.upgrade.accepted"],
      "clientEvents": ["audio.binary", "end.text-json"],
      "serverEvents": ["result.text-json", "error.text-json", "tts.audio.binary", "final.text-json"],
      "vadModes": ["server-vad"],
      "terminal": "After client type=end, final=1 ends text translation; when optional TTS is requested final=2 is the complete terminal. Socket close and errors also terminate the connection.",
      "reuse": "single-session",
      "idleTimeoutSeconds": 15,
      "textDeltaSemantics": "replaceable-snapshot"
    },
    {
      "id": "tencent-asr-v2-lifecycle",
      "handshake": ["websocket.upgrade.accepted"],
      "clientEvents": ["audio.binary", "end.text-json"],
      "serverEvents": ["slice-type-0", "slice-type-1", "slice-type-2", "final", "error"],
      "vadModes": ["server-vad"],
      "terminal": "Top-level final=1 or an error/close terminates the recognition stream; slice_type=2 is a stable slice, not the whole connection terminal.",
      "reuse": "single-session",
      "idleTimeoutSeconds": 15,
      "textDeltaSemantics": "replaceable-snapshot"
    },
    {
      "id": "tencent-sts-lifecycle",
      "handshake": ["Handshake.Code=0"],
      "clientEvents": ["audio.binary", "Finish.text-json"],
      "serverEvents": ["Handshake", "AsrResult", "LLMResult", "tts.audio.binary", "ProcessEof"],
      "vadModes": ["server-vad"],
      "terminal": "Client sends Finish and stops audio; ProcessEof with Code=0 followed by server close is the normal session terminal. A zero-length TTS Binary frame is only an optional sentence boundary.",
      "reuse": "single-session",
      "idleTimeoutSeconds": 30,
      "textDeltaSemantics": "mixed"
    },
    {
      "id": "tencent-tts-ws-v1-lifecycle",
      "handshake": ["websocket.upgrade.accepted"],
      "clientEvents": [],
      "serverEvents": ["audio.binary", "subtitle.text-json", "final.text-json", "error.text-json"],
      "vadModes": ["none"],
      "terminal": "The server emits final=1 after all audio; the client then closes the WebSocket.",
      "reuse": "single-request",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "not-applicable"
    },
    {
      "id": "tencent-tts-wsv2-lifecycle",
      "handshake": ["ready=1"],
      "clientEvents": ["ACTION_SYNTHESIS", "ACTION_COMPLETE", "ACTION_RESET"],
      "serverEvents": ["audio.binary", "subtitle.text-json", "heartbeat=1", "final=1", "error"],
      "vadModes": ["none"],
      "terminal": "ACTION_COMPLETE drains queued synthesis; final=1 indicates all text is synthesized and the client closes. Ten minutes without text causes a drain and server close.",
      "reuse": "sequential-tasks",
      "idleTimeoutSeconds": 600,
      "textDeltaSemantics": "not-applicable"
    },
    {
      "id": "tencent-cloudapi-sync-lifecycle",
      "handshake": [],
      "clientEvents": ["https.request"],
      "serverEvents": ["https.response", "https.error"],
      "vadModes": ["none"],
      "terminal": "A successful HTTPS response containing the Base64 audio is the request terminal.",
      "reuse": "single-request",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "not-applicable"
    },
    {
      "id": "tencent-cloudapi-async-lifecycle",
      "handshake": [],
      "clientEvents": ["CreateTtsTask.request"],
      "serverEvents": ["CreateTtsTask.accepted", "CreateTtsTask.error"],
      "vadModes": ["none"],
      "terminal": "CreateTtsTask success only accepts the asynchronous task. Synthesis completion requires the separate result-query API and must not be inferred from HTTP 200.",
      "reuse": "single-request",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "not-applicable"
    }
  ],
  "apiFamilies": [
    {
      "id": "tencent-speech-translate",
      "displayName": "Tencent realtime speech translation",
      "baseUrlTemplate": "wss://asr.cloud.tencent.com",
      "endpointTemplate": "/asr/speech_translate/{appid}",
      "endpointStatus": "verified",
      "modelAddressing": "model-id",
      "apiVersion": "speech-translate-v1",
      "transportId": "tencent-ws-json-raw-binary",
      "authProfileIds": ["speech-translate-hmac-sha1-query"],
      "defaultAuthProfileId": "speech-translate-hmac-sha1-query",
      "maturity": "unspecified",
      "documentationIds": ["speech-translate-api", "speech-translate-product", "speech-translate-example", "speech-sdk-overview"]
    },
    {
      "id": "tencent-asr-v2",
      "displayName": "Tencent realtime ASR WebSocket v2",
      "baseUrlTemplate": "wss://asr.cloud.tencent.com",
      "endpointTemplate": "/asr/v2/{appid}",
      "endpointStatus": "verified",
      "modelAddressing": "model-id",
      "apiVersion": "asr-v2",
      "transportId": "tencent-ws-json-raw-binary",
      "authProfileIds": ["asr-v2-hmac-sha1-query"],
      "defaultAuthProfileId": "asr-v2-hmac-sha1-query",
      "maturity": "ga",
      "documentationIds": ["asr-websocket", "asr-api-overview", "asr-formal-product"]
    },
    {
      "id": "tencent-sts",
      "displayName": "Tencent MPS WebSocket STS",
      "baseUrlTemplate": "wss://mps.cloud.tencent.com",
