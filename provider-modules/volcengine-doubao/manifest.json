  "transports": [
    {
      "id": "volc-ark-sse-json",
      "kind": "sse",
      "requestFraming": "json",
      "responseFraming": "sse",
      "requestEnvelope": { "kind": "none", "byteOrder": "not-applicable", "description": "HTTPS JSON request body." },
      "responseEnvelope": { "kind": "none", "byteOrder": "not-applicable", "description": "UTF-8 SSE records. Terminal records are API-family-specific: typed Responses events versus Chat Completions data records." }
    },
    {
      "id": "volc-seed-asr-binary-v3",
      "kind": "websocket",
      "requestFraming": "binary",
      "responseFraming": "binary",
      "requestEnvelope": { "kind": "typed-header", "id": "volc-seed-asr-nibble-sequence-v1", "byteOrder": "big-endian", "description": "Four-byte nibble header, optional signed sequence, unsigned payload length, then JSON or audio payload, commonly gzip-compressed." },
      "responseEnvelope": { "kind": "typed-header", "id": "volc-seed-asr-nibble-sequence-v1", "byteOrder": "big-endian", "description": "Four-byte nibble header, optional signed sequence, unsigned payload length, then JSON or error payload." }
    },
    {
      "id": "volc-ast-protobuf-v2",
      "kind": "websocket",
      "requestFraming": "protobuf",
      "responseFraming": "protobuf",
      "requestEnvelope": { "kind": "none", "byteOrder": "not-applicable", "description": "Each WebSocket Binary frame is exactly one serialized TranslateRequest protobuf message." },
      "responseEnvelope": { "kind": "none", "byteOrder": "not-applicable", "description": "Each WebSocket Binary frame is exactly one serialized TranslateResponse protobuf message." }
    },
    {
      "id": "volc-realtime-voice-json-v3",
      "kind": "websocket",
      "requestFraming": "json-base64",
      "responseFraming": "json-base64",
      "requestEnvelope": { "kind": "none", "byteOrder": "not-applicable", "description": "WebSocket Text JSON events; audio bytes are Base64 in JSON." },
      "responseEnvelope": { "kind": "none", "byteOrder": "not-applicable", "description": "WebSocket Text JSON events; output audio deltas are Base64 in JSON." }
    },
    {
      "id": "volc-realtime-voice-binary-legacy",
      "kind": "websocket",
      "requestFraming": "binary",
      "responseFraming": "binary",
      "requestEnvelope": { "kind": "typed-header", "id": "volc-realtime-voice-event-envelope-legacy", "byteOrder": "big-endian", "description": "Historical four-byte event-oriented Volcengine binary framing." },
      "responseEnvelope": { "kind": "typed-header", "id": "volc-realtime-voice-event-envelope-legacy", "byteOrder": "big-endian", "description": "Historical four-byte event-oriented Volcengine binary framing." }
    },
    {
      "id": "volc-tts-binary-event-v3",
      "kind": "websocket",
      "requestFraming": "binary",
      "responseFraming": "binary",
      "requestEnvelope": { "kind": "typed-header", "id": "volc-tts-event-envelope-v3", "byteOrder": "big-endian", "description": "Four-byte nibble header with WithEvent flag, signed event id, length-prefixed connect/session ids, optional sequence, payload length, and payload." },
      "responseEnvelope": { "kind": "typed-header", "id": "volc-tts-event-envelope-v3", "byteOrder": "big-endian", "description": "Event-oriented TTS V3 envelope; distinct from the Seed ASR sequence envelope." }
    },
    {
      "id": "volc-tts-binary-sequence-v1",
      "kind": "websocket",
      "requestFraming": "binary",
      "responseFraming": "binary",
      "requestEnvelope": { "kind": "typed-header", "id": "volc-tts-sequence-envelope-v1", "byteOrder": "big-endian", "description": "Historical four-byte sequence protocol." },
      "responseEnvelope": { "kind": "typed-header", "id": "volc-tts-sequence-envelope-v1", "byteOrder": "big-endian", "description": "Historical audio sequence protocol; a negative sequence is terminal." }
    }
  ],
  "audioProfiles": [
    {
      "id": "volc-seed-asr-pcm16-audio",
      "input": { "required": true, "formats": ["pcm-s16le"], "sampleRatesHz": [16000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian"] },
      "output": { "required": false, "formats": [], "sampleRatesHz": [], "channels": [] }
    },
    {
      "id": "volc-ast-s2t-audio",
      "input": { "required": true, "formats": ["pcm-s16le", "wav-pcm-s16le"], "sampleRatesHz": [16000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian"], "chunkDurationMs": { "recommended": 80 } },
      "output": { "required": false, "formats": [], "sampleRatesHz": [], "channels": [] }
    },
    {
      "id": "volc-ast-s2s-pcm16-audio",
      "input": { "required": true, "formats": ["pcm-s16le", "wav-pcm-s16le"], "sampleRatesHz": [16000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian"], "chunkDurationMs": { "recommended": 80 } },
      "output": { "required": true, "formats": ["pcm-s16le"], "sampleRatesHz": [16000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian"] }
    },
    {
      "id": "volc-realtime-voice-v3-audio",
      "input": { "required": true, "formats": ["pcm-s16le", "speech-opus"], "sampleRatesHz": [16000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian", "not-applicable"], "chunkDurationMs": { "recommended": 20 } },
      "output": { "required": true, "formats": ["pcm-s16le", "ogg-opus"], "sampleRatesHz": [24000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian", "not-applicable"] }
    },
    {
      "id": "volc-realtime-voice-legacy-audio",
      "input": { "required": true, "formats": ["pcm-s16le"], "sampleRatesHz": [16000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian"] },
      "output": { "required": true, "formats": ["pcm-s16le"], "sampleRatesHz": [24000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian"] }
    },
    {
      "id": "volc-tts-v3-audio",
      "input": { "required": false, "formats": [], "sampleRatesHz": [], "channels": [] },
      "output": { "required": true, "formats": ["pcm-s16le", "wav-pcm-s16le", "mp3", "ogg-opus"], "sampleRatesHz": [8000, 16000, 22050, 24000, 32000, 44100, 48000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian", "not-applicable"] }
    },
    {
      "id": "volc-tts-v1-legacy-audio",
      "input": { "required": false, "formats": [], "sampleRatesHz": [], "channels": [] },
      "output": { "required": true, "formats": ["pcm-s16le", "mp3", "ogg-opus"], "sampleRatesHz": [8000, 16000, 24000, 48000], "channels": [1], "bitDepths": [16], "endianness": ["little-endian", "not-applicable"] }
    }
  ],
  "lifecycleProfiles": [
    {
      "id": "volc-ark-responses-sse-lifecycle",
      "handshake": [],
      "clientEvents": ["https.json.request"],
      "serverEvents": ["sse.response.created", "sse.response.output_text.delta", "sse.response.completed", "sse.response.failed", "sse.response.incomplete", "https.error"],
      "vadModes": ["none"],
      "terminal": "response.completed is the successful terminal event; response.failed and response.incomplete are non-success terminals. Do not require the Chat Completions data: [DONE] sentinel.",
      "reuse": "single-request",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "append-delta"
    },
    {
      "id": "volc-ark-chat-sse-lifecycle",
      "handshake": [],
      "clientEvents": ["https.json.request"],
      "serverEvents": ["sse.chat.completion.chunk", "sse.choice.finish_reason", "sse.done", "https.error"],
      "vadModes": ["none"],
      "terminal": "A choice finish_reason records semantic completion and data: [DONE] terminates the Chat Completions SSE stream.",
      "reuse": "single-request",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "append-delta"
    },
    {
      "id": "volc-seed-asr-lifecycle",
      "handshake": ["full-client-request"],
      "clientEvents": ["full-client-request", "audio-only", "last-audio"],
      "serverEvents": ["full-server-response", "error", "last-package"],
      "vadModes": ["server-vad", "semantic-vad"],
      "terminal": "is_last_package=true or the negative final response sequence is the transport terminal. utterances.definite=true only stabilizes an utterance.",
      "reuse": "single-session",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "replaceable-snapshot"
    },
    {
      "id": "volc-ast-v2-lifecycle",
      "handshake": ["StartSession=100", "SessionStarted=150"],
      "clientEvents": ["TaskRequest=200", "UpdateConfig=201", "FinishSession=102"],
      "serverEvents": ["source-subtitle=650-652", "translated-subtitle=653-655", "tts=350-352", "AudioMuted=250", "Usage=154", "SessionFinished=152", "SessionFailed=153"],
      "vadModes": ["server-vad"],
      "terminal": "FinishSession requests drain; SessionFinished is normal terminal and SessionFailed is error terminal. AudioMuted is not terminal.",
      "reuse": "single-session",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "mixed"
    },
    {
      "id": "volc-realtime-voice-v3-lifecycle",
      "handshake": ["session.create", "session.created"],
      "clientEvents": ["session.update", "input_audio_buffer.append", "input_audio_buffer.commit", "input_audio_mute.commit", "input_audio_mute.unmute.commit", "response.cancel", "session.close"],
      "serverEvents": ["session.updated", "asr.started", "asr.delta", "asr.completed", "asr.failed", "response.text.delta", "response.text.done", "response.audio.started", "response.audio.delta", "response.audio.done", "response.done", "session.closed", "error"],
      "vadModes": ["server-vad", "manual", "client-activity"],
      "terminal": "response.done ends one turn, response.audio.done ends one output-audio turn, and session.closed is the full session terminal.",
      "reuse": "multi-turn",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "append-delta"
    },
    {
      "id": "volc-realtime-voice-legacy-lifecycle",
      "handshake": ["legacy-start-connection", "legacy-connection-started"],
      "clientEvents": ["legacy-audio", "legacy-finish-session"],
      "serverEvents": ["legacy-asr", "legacy-dialogue", "legacy-audio", "legacy-session-finished", "legacy-error"],
      "vadModes": ["server-vad", "manual"],
      "terminal": "Historical event protocol session-finished or error event.",
      "reuse": "multi-turn",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "mixed"
    },
    {
      "id": "volc-tts-v3-unidirectional-lifecycle",
      "handshake": ["websocket.upgrade.accepted"],
      "clientEvents": ["one-shot-synthesis-request"],
      "serverEvents": ["TTSSentenceStart", "TTSResponse", "TTSSentenceEnd", "TTSSubtitle", "SessionFinished", "error"],
      "vadModes": ["none"],
      "terminal": "SessionFinished is the normal terminal event; the error event is terminal on failure.",
      "reuse": "single-request",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "not-applicable"
    },
    {
      "id": "volc-tts-v3-bidirectional-lifecycle",
      "handshake": ["StartConnection", "ConnectionStarted", "StartSession", "SessionStarted"],
      "clientEvents": ["TaskRequest", "FinishSession", "CancelSession", "FinishConnection"],
      "serverEvents": ["TTSResponse", "SessionFinished", "SessionCanceled", "ConnectionFinished", "error"],
      "vadModes": ["none"],
      "terminal": "SessionFinished ends one synthesis task; ConnectionFinished ends the reusable WebSocket connection.",
      "reuse": "sequential-tasks",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "not-applicable"
    },
    {
      "id": "volc-tts-v1-legacy-lifecycle",
      "handshake": ["websocket.upgrade.accepted"],
      "clientEvents": ["legacy-full-request"],
      "serverEvents": ["legacy-audio-sequence", "legacy-error"],
      "vadModes": ["none"],
      "terminal": "A negative response sequence marks the last audio package in the historical protocol.",
      "reuse": "single-request",
      "idleTimeoutSeconds": null,
      "textDeltaSemantics": "not-applicable"
    }
  ],
