        { "location": "header", "name": "X-Api-Resource-Id", "source": "static", "staticValue": "volc.seedasr.sauc.concurrent", "required": true },
        { "location": "header", "name": "X-Api-Request-Id", "source": "derived", "derivation": "new UUID per connection", "required": true },
        { "location": "header", "name": "X-Api-Sequence", "source": "static", "staticValue": "-1", "required": true }
      ]
    },
    {
      "id": "volc-ast-current-headers",
      "type": "multi-header-api-key",
      "credentialId": "volc-speech-api-key",
      "parameters": [
        { "location": "header", "name": "X-Api-Key", "source": "credential", "credentialFieldId": "api-key", "required": true },
        { "location": "header", "name": "X-Api-Resource-Id", "source": "static", "staticValue": "volc.service_type.10053", "required": true }
      ]
    },
    {
      "id": "volc-realtime-voice-api-key",
      "type": "api-key",
