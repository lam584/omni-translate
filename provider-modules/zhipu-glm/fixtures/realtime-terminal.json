  "scenario": "GLM-Realtime uses response.done for every final status",
  "data": {
    "completedSequence": [
      {
        "type": "response.audio.done",
        "response_id": "<sanitized-completed-response-id>"
      },
      {
        "type": "response.done",
        "response": {
          "id": "<sanitized-completed-response-id>",
          "object": "realtime.response",
          "status": "completed",
          "usage": {
            "total_tokens": 0
          }
        }
      }
    ],
    "cancelledSequence": [
      {
        "direction": "client",
        "type": "response.cancel"
      },
      {
        "direction": "server",
        "type": "response.cancelled",
        "response": {
          "id": "<sanitized-cancelled-response-id>",
          "object": "realtime.response",
          "status": "cancelled"
        }
      },
      {
        "direction": "server",
        "type": "response.audio.done",
        "response_id": "<sanitized-cancelled-response-id>"
      },
      {
        "direction": "server",
        "type": "response.done",
        "response": {
          "id": "<sanitized-cancelled-response-id>",
          "object": "realtime.response",
          "status": "cancelled"
        }
      }
    ],
    "assertions": [
      "response.done is the universal terminal event",
      "The response.status value decides completed versus cancelled",
      "Type-local done events can also be emitted for cancelled or incomplete responses",
      "Ordering is guaranteed within one event type, but different event types must not be assumed to have a total order"
