  "credentials": [
    {
      "id": "zhipu-glm.api-key",
      "reference": "credential://provider/zhipu-glm/default",
      "fields": [
        {
          "id": "api-key",
          "label": "Zhipu API key",
          "secret": true,
          "required": true,
          "format": "{id}.{secret}"
        }
      ]
    }
  ],
  "authProfiles": [
    {
      "id": "zhipu-glm.bearer-api-key",
      "type": "bearer",
      "credentialId": "zhipu-glm.api-key",
      "parameters": [
        {
          "location": "header",
          "name": "Authorization",
          "source": "credential",
          "credentialFieldId": "api-key",
          "scheme": "Bearer",
          "required": true
        }
      ]
    },
    {
      "id": "zhipu-glm.realtime-jwt",
      "type": "bearer",
      "credentialId": "zhipu-glm.api-key",
      "parameters": [
        {
          "location": "header",
          "name": "Authorization",
          "source": "derived",
          "derivation": "Split {id}.{secret}; sign an HS256 JWT with header alg=HS256 and sign_type=SIGN, payload api_key=id, exp=Unix-seconds-now plus TTL seconds, and timestamp=Unix-milliseconds-now; send the result with the Bearer scheme.",
          "scheme": "Bearer",
          "required": true
        }
      ],
      "signing": {
        "algorithm": "hmac-sha256",
        "canonicalization": "JWT compact serialization: base64url(header JSON) + '.' + base64url(payload JSON), signed with the secret portion of the API key. exp uses Unix seconds; timestamp uses Unix milliseconds.",
        "signatureEncoding": "base64url",
        "signatureParameterName": "Authorization",
        "signedParameterNames": [
          "header.alg",
          "header.sign_type",
          "payload.api_key",
          "payload.exp",
          "payload.timestamp"
        ]
      },
      "credentialBootstrap": {
        "kind": "jwt-derivation",
        "description": "A trusted component derives the short-lived JWT from the id and secret portions of the API key. Both the direct API key and the JWT are documented as Authorization Bearer values; browsers still cannot add the required native WebSocket header directly.",
        "documentationIds": [
          "zhipu-glm.realtime-guide",
          "zhipu-glm.realtime-llm-reference",
          "zhipu-glm.realtime-sdk"
        ]
      }
    }
  ],
  "transports": [
    {
      "id": "zhipu-glm.http-json",
      "kind": "http",
      "requestFraming": "json",
      "responseFraming": "json",
      "requestEnvelope": {
        "kind": "none",
        "byteOrder": "not-applicable"
      },
      "responseEnvelope": {
        "kind": "none",
        "byteOrder": "not-applicable"
      }
    },
    {
      "id": "zhipu-glm.sse-json",
      "kind": "sse",
      "requestFraming": "json",
      "responseFraming": "sse",
      "requestEnvelope": {
        "kind": "none",
        "byteOrder": "not-applicable"
      },
      "responseEnvelope": {
        "kind": "provider-defined",
        "id": "zhipu-glm.sse-event",
        "byteOrder": "not-applicable",
        "description": "Server-Sent Event data containing a provider JSON object or the explicit [DONE] marker."
      }
    },
    {
      "id": "zhipu-glm.sse-multipart",
      "kind": "sse",
      "requestFraming": "multipart",
      "responseFraming": "sse",
      "requestEnvelope": {
        "kind": "provider-defined",
        "id": "zhipu-glm.multipart-form",
        "byteOrder": "not-applicable",
        "description": "multipart/form-data containing a file or base64 audio field plus model and streaming controls."
      },
      "responseEnvelope": {
        "kind": "provider-defined",
        "id": "zhipu-glm.sse-event",
        "byteOrder": "not-applicable",
        "description": "Server-Sent Event data containing transcription JSON and the [DONE] marker."
      }
    },
    {
      "id": "zhipu-glm.websocket-json",
      "kind": "websocket",
      "requestFraming": "json",
      "responseFraming": "json",
      "requestEnvelope": {
        "kind": "provider-defined",
        "id": "zhipu-glm.realtime-client-event",
        "byteOrder": "not-applicable",
        "description": "Native GLM-Realtime JSON event selected by its type field. Audio and video bytes are base64 strings inside JSON."
      },
      "responseEnvelope": {
        "kind": "provider-defined",
        "id": "zhipu-glm.realtime-server-event",
        "byteOrder": "not-applicable",
        "description": "Native GLM-Realtime JSON event selected by its type field; this is not the OpenAI Realtime event contract."
      }
    }
  ],
