  "lifecycleProfiles": [
    {
      "id": "zhipu-glm.openai-chat-stream",
      "handshake": [],
      "clientEvents": [
        "chat.completions.create"
      ],
      "serverEvents": [
        "chat.completion.chunk",
        "data.done"
      ],
      "vadModes": [
        "none"
      ],
      "terminal": "A finish_reason in a final chunk or the SSE data marker [DONE] terminates the request.",
      "reuse": "sequential-tasks",
      "textDeltaSemantics": "append-delta"
    },
    {
      "id": "zhipu-glm.realtime-conversation",
      "handshake": [
        "session.created",
        "session.update",
        "session.updated"
      ],
      "clientEvents": [
        "session.update",
        "input_audio_buffer.append",
        "input_audio_buffer.append_video_frame",
        "input_audio_buffer.commit",
        "input_audio_buffer.clear",
        "conversation.item.create",
        "conversation.item.delete",
        "conversation.item.retrieve",
        "response.create",
        "response.cancel"
      ],
      "serverEvents": [
        "session.created",
        "session.updated",
        "conversation.item.created",
        "conversation.item.deleted",
        "conversation.item.retrieved",
        "conversation.item.input_audio_transcription.completed",
        "conversation.item.input_audio_transcription.failed",
        "input_audio_buffer.committed",
        "input_audio_buffer.cleared",
        "input_audio_buffer.speech_started",
        "input_audio_buffer.speech_stopped",
        "response.created",
        "response.output_item.added",
        "response.output_item.done",
        "response.content_part.added",
        "response.content_part.done",
        "response.text.delta",
        "response.text.done",
        "response.audio.delta",
        "response.audio.done",
        "response.audio_transcript.delta",
        "response.audio_transcript.done",
        "response.function_call_arguments.delta",
        "response.function_call_arguments.done",
        "response.cancelled",
        "response.done",
        "rate_limits.updated",
        "heartbeat",
        "error"
      ],
      "vadModes": [
        "manual",
        "server-vad"
      ],
      "terminal": "response.done is always emitted regardless of outcome. Consumers must inspect response.status, including completed and cancelled; response.cancelled is an acknowledgement, not the universal terminal event.",
      "reuse": "multi-turn",
      "textDeltaSemantics": "append-delta"
    },
    {
      "id": "zhipu-glm.realtime-transcription",
      "handshake": [
        "session.created",
        "transcription_session.update",
        "transcription.session.updated-or-transcription_session.updated"
      ],
      "clientEvents": [
        "transcription_session.update",
        "input_audio_buffer.append",
        "input_audio_buffer.commit",
        "input_audio_buffer.clear"
      ],
      "serverEvents": [
        "transcription.session.updated",
        "transcription_session.updated",
        "conversation.item.input_audio_transcription.completed",
        "conversation.item.input_audio_transcription.failed",
        "input_audio_buffer.committed",
        "input_audio_buffer.cleared",
        "input_audio_buffer.speech_started",
        "input_audio_buffer.speech_stopped",
        "heartbeat",
        "error"
      ],
      "vadModes": [
        "manual",
        "server-vad"
      ],
      "terminal": "Each input item becomes final at conversation.item.input_audio_transcription.completed or fails at the corresponding failed event; transcription completion is asynchronous relative to model-response events.",
      "reuse": "multi-turn",
      "textDeltaSemantics": "not-applicable"
    },
    {
      "id": "zhipu-glm.asr-stream",
      "handshake": [],
      "clientEvents": [
        "audio.transcriptions.create"
      ],
      "serverEvents": [
        "audio.transcription.chunk",
        "data.done"
      ],
      "vadModes": [
        "none"
      ],
      "terminal": "The multipart HTTP/SSE request terminates at data: [DONE].",
      "reuse": "single-request",
      "textDeltaSemantics": "append-delta"
    },
    {
      "id": "zhipu-glm.tts-stream",
      "handshake": [],
      "clientEvents": [
        "audio.speech.create"
      ],
      "serverEvents": [
        "audio.speech.chunk",
        "audio.speech.stop"
      ],
      "vadModes": [
        "none"
      ],
      "terminal": "A streamed choice whose finish_reason is stop is terminal; streaming supports PCM output, not WAV framing.",
      "reuse": "single-request",
      "textDeltaSemantics": "not-applicable"
    },
    {
      "id": "zhipu-glm.voice-clone-single",
      "handshake": [],
      "clientEvents": [
        "voice.clone.create"
      ],
      "serverEvents": [
        "voice.clone.response"
      ],
      "vadModes": [
        "none"
      ],
      "terminal": "The HTTP JSON response containing the cloned voice identifier and preview file identifier is terminal.",
      "reuse": "single-request",
      "textDeltaSemantics": "not-applicable"
    }
  ],
